S_0000013403ccedb0 .scope module, "sample_storage_tb" "sample_storage_tb" 2 3;
 .timescale -9 -12;
v0000013403d56b80_0 .var "clk", 0 0;
v0000013403cc8290_0 .var "signal_strength", 7 0;
v0000013403cc8330_0 .net "stored_strength", 7 0, v0000013403d8a570_0;  1 drivers
S_0000013403cc8100 .scope module, "dut" "sample_storage" 2 13, 3 1 0, S_0000013403ccedb0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 8 "signal_strength";
    .port_info 2 /OUTPUT 8 "stored_strength";
v0000013403d56e50_0 .net "clk", 0 0, v0000013403d56b80_0;  1 drivers
v0000013403ccaf30_0 .net "signal_strength", 7 0, v0000013403cc8290_0;  1 drivers
v0000013403d8a570_0 .var "stored_strength", 7 0;
E_0000013403ccbb30 .event posedge, v0000013403d56e50_0;
    .scope S_0000013403cc8100;
T_0 ;
    %wait E_0000013403ccbb30;
    %load/vec4 v0000013403ccaf30_0;
    %assign/vec4 v0000013403d8a570_0, 0;
    %jmp T_0;
    .thread T_0;
    .scope S_0000013403ccedb0;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0000013403d56b80_0, 0, 1;
    %end;
    .thread T_1;
    .scope S_0000013403ccedb0;
T_2 ;
    %delay 5000, 0;
    %load/vec4 v0000013403d56b80_0;
    %inv;
    %store/vec4 v0000013403d56b80_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0000013403ccedb0;
T_3 ;
    %vpi_call 2 21 "$monitor", "Input = %d, Stored = %d", v0000013403cc8290_0, v0000013403cc8330_0 {0 0 0};
    %pushi/vec4 50, 0, 8;
    %store/vec4 v0000013403cc8290_0, 0, 8;
    %delay 12000, 0;
    %pushi/vec4 100, 0, 8;
    %store/vec4 v0000013403cc8290_0, 0, 8;
    %delay 20000, 0;
    %vpi_call 2 28 "$finish" {0 0 0};
    %end;
    .thread T_3;
